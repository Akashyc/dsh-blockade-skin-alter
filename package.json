{
  "name": "@local/dsh-blockade-skin-alter",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "vendor": "node scripts/vendor-gsap.mjs"
  },
  "description": "全鲸封锁：基于封锁橙的 DSH 皮肤。深空星点与神经连线背景，主题色可调（默认深海蓝 #4C6AFC），与灵魂狭间（dsh-chara-soul）同一套风格，两边都装时主题色联动。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "data/prices.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "devDependencies": {
    "gsap": "^3.15.1"
  }
}
